

# ---- Database -----------------------------------------------
DATABASE_URL=postgresql+asyncpg://splitsmart:splitsmart@localhost:5432/splitsmart
SYNC_DATABASE_URL=postgresql://splitsmart:splitsmart@localhost:5432/splitsmart

# ---- Redis --------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# ---- Authentication -----------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-in-production-generate-with-secrets-token-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
GUEST_TOKEN_EXPIRE_MINUTES=480

# ---- AI / Gemini --------------------------------------------

GEMINI_API_KEY=

# ---- Application --------------------------------------------
APP_ENV=development
APP_NAME=SplitSmart AI
APP_VERSION=1.0.0
CORS_ORIGINS=http://localhost:3000

# ---- File Upload --------------------------------------------
MAX_UPLOAD_SIZE_MB=10
UPLOAD_DIR=./uploads

# ---- Celery -------------------------------------------------
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ---- Rate Limiting ------------------------------------------
RATE_LIMIT_AI_PER_MINUTE=10
RATE_LIMIT_UPLOAD_PER_HOUR=20
